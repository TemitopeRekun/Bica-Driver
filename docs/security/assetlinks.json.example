# Android App Links Association Template
# Place this file on your web host at: https://app.bicadriver.ng/.well-known/assetlinks.json
# Ensure the Content-Type is served as: application/json

[
  {
    "relation": [
      "delegate_permission/common.handle_all_urls"
    ],
    "target": {
      "namespace": "android_app",
      "package_name": "com.bicadriver.app",
      "sha256_cert_fingerprints": [
        "YOUR_PRODUCTION_RELEASE_SHA256_FINGERPRINT_PLACEHOLDER",
        "YOUR_DEBUG_SHA256_FINGERPRINT_PLACEHOLDER"
      ]
    }
  }
]
